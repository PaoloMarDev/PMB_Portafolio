---
import '../styles/index.css'
import Inicio from '../components/Inicio.astro';
import Layout from '../layouts/Layout.astro';
import AboutMe from '../components/AboutMe.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';

import banner from '../assets/bannerBackground.gif'
import avatar from '../assets/Avatar.png'
import { Image } from 'astro:assets';

---

<Layout 
    title="Portfolio de PaoloMarDev - Desarrollador y Programador"
    dexcrioption="">
    <figure class="banner-holder">
        <Image class="banner" src={banner} alt="banner de fondo"/>
    </figure>
    <section class="content">
        <section class="content-container">
            <Image class="profile-pic animate-on-scroll" src={avatar} alt="foto de perfil" />
            <Inicio/>
            <AboutMe/>
            <Projects />
            <Contact />
            <br>
        </section>
    </section>
</Layout>
