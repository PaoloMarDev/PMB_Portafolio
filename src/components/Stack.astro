---
import '../styles/Stacks.css'
---

<!-- STACK -->
<section id="stack">
  <div class="container">
    <div class="section-eyebrow reveal">Stack tecnológico</div>
    <h2 class="section-title reveal">Tecnologías con las<br>que construyo.</h2>
 
    <div class="stack-grid">
      <div class="stack-group reveal">
        <div class="stack-group-title">Frontend</div>
        <div class="stack-items">
          <div class="stack-item"><div class="stack-dot" style="background:var(--accent2)"></div><span class="stack-name">React</span></div>
          <div class="stack-item"><div class="stack-dot" style="background:var(--accent2)"></div><span class="stack-name">HTML / CSS</span></div>
          <div class="stack-item"><div class="stack-dot" style="background:var(--accent2)"></div><span class="stack-name">JavaScript</span></div>
          <div class="stack-item"><div class="stack-dot" style="background:rgba(167,139,250,0.4)"></div><span class="stack-name" style="color:var(--text-ter)">Astro</span></div>
        </div>
      </div>
      <div class="stack-group reveal">
        <div class="stack-group-title">Backend &amp; Cloud</div>
        <div class="stack-items">
          <div class="stack-item"><div class="stack-dot" style="background:var(--green)"></div><span class="stack-name">Node.js</span></div>
          <div class="stack-item"><div class="stack-dot" style="background:var(--green)"></div><span class="stack-name">SQL / MySQL</span></div>
          <div class="stack-item"><div class="stack-dot" style="background:var(--green)"></div><span class="stack-name">AWS</span></div>
          <div class="stack-item"><div class="stack-dot" style="background:rgba(52,211,153,0.4)"></div><span class="stack-name" style="color:var(--text-ter)">REST APIs</span></div>
        </div>
      </div>
      <div class="stack-group reveal">
        <div class="stack-group-title">Game Dev &amp; Video Edit</div>
        <div class="stack-items">
          <div class="stack-item"><div class="stack-dot" style="background:var(--amber)"></div><span class="stack-name">Unity</span></div>
          <div class="stack-item"><div class="stack-dot" style="background:var(--amber)"></div><span class="stack-name">C#</span></div>
          <div class="stack-item"><div class="stack-dot" style="background:rgba(251,191,36,0.4)"></div><span class="stack-name" style="color:var(--text-ter)">DaVinci Resolve</span></div>
        </div>
      </div>
      <div class="stack-group reveal">
        <div class="stack-group-title">Metodología &amp; Tools</div>
        <div class="stack-items">
          <div class="stack-item"><div class="stack-dot" style="background:var(--blue)"></div><span class="stack-name">SCRUM / Agile</span></div>
          <div class="stack-item"><div class="stack-dot" style="background:var(--blue)"></div><span class="stack-name">Git / GitHub</span></div>
          <div class="stack-item"><div class="stack-dot" style="background:var(--blue)"></div><span class="stack-name">Liderazgo de equipo</span></div>
          <div class="stack-item"><div class="stack-dot" style="background:rgba(96,165,250,0.4)"></div><span class="stack-name" style="color:var(--text-ter)">Figma</span></div>
        </div>
      </div>
    </div>
  </div>
</section>