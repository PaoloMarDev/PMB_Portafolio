---
import { Image } from "astro:assets"
import github from '../assets/github.png'
import linkedin from '../assets/linkedin.png'
---

<section class="inicio">
    <div class="intro animate-on-scroll">
        <h1 class="name">PaoloMar<span>.</span>Dev</h1>
        <p class="rol">Desarrollador Full-Stack <span>&lt;/&gt;</span></p>
        <p class="resume">Experiencia en el desarrollo de aplicaciones con soluciones claras, funcionales y bien estructuradas, cuidando la experiencia de usuario</p>
        <div class="icons">
            <a href="https://github.com/PaoloMarDev" target="_blank"><Image class="githubIcon" src={github} alt="github Icon" /></a>
            <a href="https://www.linkedin.com/in/paolo-martini-bellot/" target="_blank"><Image class="linkedinIcon" src={linkedin} alt="linkedin Icon" /></a>
        </div>
    </div>
</section>

<style>
    p{
        margin: 0;
        padding: 0;
        color: #acacac;
    }
    span{
        color: #8de480;
    }
    .intro{
        display: flex;
        flex-direction: column;
    }
    .name{
        color: white;
        font-size: clamp(1.5rem, 5vw, 5rem);
        font-weight: bold;
        text-shadow: 2px 4px 10px black;
        margin-top: 3%;
        margin-bottom: 0%;
    }
    .rol{
        font-size: clamp(1.5rem, 2vw, 3rem);
        font-weight: bold;
        text-shadow: 2px 4px 10px black;
        margin-top: 1%;
    }
    .resume{
        font-size: clamp(1rem, 1vw, 2rem);
        font-weight: bold;
        text-shadow: 2px 4px 10px black;
        margin-top: 1%;
        width: 40vw;
    }
    .icons{
        display: flex;
        flex-direction: row;
        margin-top: 2%;
        width: clamp(40px, 3vw, 55px);
        margin-bottom: 8vh;
        align-items: center;
        gap: 2vw;
    }
    .githubIcon,
    .linkedinIcon{
        width: 3vw;
        height: auto;
        box-shadow: 2px 4px 10px black;
        border-radius: 70%;
        transition:
            transform 0.15s ease,
            filter 0.15s ease;
        transform-origin: center;
        will-change: transform;
    }
    
    .githubIcon:hover,
    .linkedinIcon:hover{
        transform: scale(1.15) translateY(-2px);
        filter: brightness(1.2);
    }
</style>
