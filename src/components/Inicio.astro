---
import { Image } from "astro:assets"
import github from '../assets/github.png'
import linkedin from '../assets/linkedin.png'
---

<section class="inicio">
    <div class="intro">
        <p class="name">PaoloMar<span>.</span>Dev</p>
        <p class="rol">Desarrollador Full-Stack <span>&lt;/&gt;</span></p>
        <p class="resume">Experiencia en el desarrollo de aplicaciones con soluciones claras, funcionales y bien estructuradas, cuidando la experiencia de usuario</p>
        <div class="icons">
            <a href="https://github.com/PaoloMarDev" target="_blank"><Image class="githubIcon" src={github} alt="github Icon" /></a>
            <a href="https://www.linkedin.com/in/paolo-martini-bellot/" target="_blank"><Image class="linkedinIcon" src={linkedin} alt="linkedin Icon" /></a>
        </div>
    </div>
</section>

<style>
    .inicio{
        min-height: auto;
        width: 100%;
    }
    p{
        margin: 0;
        padding: 0;
        color: #acacac;
    }
    span{
        color: #8de480;
    }
    .intro{
        display: flex;
        flex-direction: column;
    }
    .name{
        color: white;
        font-size: clamp(1.5rem, 5vw, 5rem);
        font-weight: bold;
        text-shadow: 2px 4px 10px black;
        margin-left: 15%;
        margin-top: 3%;
    }
    .rol{
        font-size: clamp(1.5rem, 2vw, 3rem);
        font-weight: bold;
        text-shadow: 2px 4px 10px black;
        margin-left: 15%;
        margin-top: 1%;
    }
    .resume{
        font-size: clamp(1rem, 1vw, 2rem);
        font-weight: bold;
        text-shadow: 2px 4px 10px black;
        margin-left: 15%;
        margin-top: 1%;
        width: 40vw;
    }
    .icons{
        display: flex;
        flex-direction: row;
        margin-left: 15%;
        margin-top: 2%;
        width: 50%;
        margin-bottom: 1%;
    }
    .githubIcon{
        width: 3vw;
        height: auto;
        margin-right: 0;
        box-shadow: 2px 4px 10px black;
        border-radius: 70%;
        transition: width 0.15s;
    }
    .githubIcon:hover{
        width: 3.5vw;
    }
    .linkedinIcon{
        width: 3vw;
        height: auto;
        margin-left: 2vw;
        box-shadow: 2px 4px 10px black;
        border-radius: 70%;
        transition: width 0.15s;
    }
    .linkedinIcon:hover{
    width: 3.5vw;
    }
</style>