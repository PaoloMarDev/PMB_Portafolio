---
import '../styles/Contact.css'
---

<section id="contact" >
    <div class="contacts-header">
        <div class="linea derecha"></div>
        <h2 class="contacts-title">Contacto</h2>
        <div class="linea izquieda"></div>
    </div>
    <div class="contact-container">
        <button id="email-btn" class="contact-card">
            <img src={`${import.meta.env.BASE_URL}email.webp`} alt="Icono de correo" class="contact-icon" />
            <span>PaoloMarDev_@outlook.com</span>
        </button>
        <a href="https://www.linkedin.com/in/paolo-martini-bellot/" target="_blank" rel="noopener noreferrer" class="contact-card">
            <img src={`${import.meta.env.BASE_URL}/linkedin.webp`} alt="Icono de LinkedIn" class="contact-icon" />
            <span>Paolo - Linkedin</span>
        </a>
    </div>
</section>

<script>
    import '../scripts/EmailButton.js'
</script>
