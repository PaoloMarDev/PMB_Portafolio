---
import { Image } from "astro:assets";
import greenMonster from '../assets/GreenMonster.gif'
---
<section id="about" >
    <div class="AboutMe-header">
        <div class="linea derecha"></div>
        <h2 class="Aboutme-title">Sobre mi</h2>
        <div class="linea izquieda"></div>
    </div>
    <section class="info">
        <div>
            <p class="description">
                Soy desarrollador full-stack enfocado en construir aplicaciones que resuelvan problemas.
                Me interesa que las soluciones no solo funcionen, sino que sean claras, 
                bien pensadas y fáciles de usar.
                <br><br>
                Soy desarrollador full-stack enfocado en construir aplicaciones que resuelvan problemas.
                Me interesa que las soluciones no solo funcionen, sino que sean claras, 
                bien pensadas y fáciles de usar.

            </p>
        </div>
        <figure class="monsterImage">
            <Image class="monster" src={greenMonster} alt="" />
        </figure>
    </section>
</section>

<style>
    p{
        margin: 0;
        padding: 0;
        color: #acacac;
    }
    figure{
        margin: 0;
        padding: 0;
    }
    .AboutMe-header{
        display: flex;
        align-items: center;
        gap: 2rem;
    }
    .Aboutme-title{
        color: white;
        font-weight: bold;
        font-size: clamp(1rem, 3vw, 4rem);
        text-align: center;
        width: auto;
    }
    .linea{
        flex-grow: 1;
        height: 1px;
        background-color: white;
    }
    .linea.derecha{
    }
    .linea.izquieda{
    }
    .info{
        display: flex;
        justify-content: space-between;
        flex: 1;
        margin: 0%;
        padding: 0%;
    }
    .description{
        font-size: clamp(1rem, 1vw, 2rem);
        font-weight: bold;
        text-shadow: 2px 4px 10px black;
        max-width: 75%;
        width: 100%;
    }
    .monsterImage{
        padding-right: 8%;
        margin-top: -5%;
    }
    .monster{
        width: auto;
        height: clamp(5vw, 20vw, 20vw);
        image-rendering: pixelated;
    }
    

</style>